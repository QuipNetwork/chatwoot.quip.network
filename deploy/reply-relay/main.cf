# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Receive-only MX for reply.quip.network (host: developers-portal droplet).
#
# Chatwoot sends support mail with Reply-To: reply+<conversation-uuid>@reply.quip.network.
# This Postfix accepts exactly those addresses from the internet and pipes each
# message to Chatwoot's relay ingress (master.cf: chatwoot). It accepts nothing
# else over SMTP, relays nothing, and sends nothing off the box: DigitalOcean
# blocks outbound port 25 anyway, and refusals happen during the SMTP handshake,
# so no bounce is ever generated for mail it won't take.

compatibility_level = 3.6
myhostname = mx.reply.quip.network
myorigin = $myhostname
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

inet_interfaces = all
inet_protocols = all
mynetworks = 127.0.0.0/8 [::1]/128

# Local mail (cron, root) still lands in /var/mail on the box. SMTP clients
# can't reach these mailboxes: smtpd_recipient_restrictions below only lets
# reply+<uuid>@reply.quip.network through.
mydestination = $myhostname, localhost
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# The one domain we take mail for, and the one address shape in it.
relay_domains = reply.quip.network
relay_recipient_maps = pcre:/etc/postfix/chatwoot-recipients.pcre
transport_maps = texthash:/etc/postfix/chatwoot-transport
chatwoot_destination_recipient_limit = 1

smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions =
    check_recipient_access pcre:/etc/postfix/chatwoot-recipients.pcre,
    reject

# Nothing leaves the box over SMTP.
default_transport = error:this host does not send mail
relay_transport = error:no transport for this relay domain

# 25 MB: room for screenshots and logs, refused above that.
message_size_limit = 26214400

# Opportunistic TLS on receive. Senders don't verify an MX's certificate, so
# Debian's self-signed snakeoil pair is enough.
smtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file = /etc/ssl/private/ssl-cert-snakeoil.key
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
